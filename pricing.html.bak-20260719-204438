<script type="text/x-dc" data-dc-script data-props="{&quot;$preview&quot;:{&quot;width&quot;:1080,&quot;height&quot;:820}}">
class Component extends DCLogic {
  componentDidMount(){
    const root=document.querySelector('.kw-price'); if(!root) return;
    this.wireToggle(root);
    const boot=()=>{
      if(!window.KnowherePage||!window.KnowhereParticleBanner){ return setTimeout(boot,50); }
      window.KnowherePage.injectLogo(root);
      this._stopBanner=window.KnowhereParticleBanner(root,'Pricing','chart');
    };
    boot();
  }
  componentWillUnmount(){ if(this._stopBanner) this._stopBanner(); }

  wireToggle(root){
    const mB=this.btnMonthly, yB=this.btnYearly, tag=this.saveTag;
    if(!mB||!yB) return;
    const set=(mode)=>{
      mB.classList.toggle('on',mode==='monthly');
      yB.classList.toggle('on',mode==='yearly');
      if(tag) tag.style.visibility = mode==='yearly' ? 'visible' : 'hidden';
      root.querySelectorAll('[data-monthly]').forEach(el=>{ el.textContent=el.dataset[mode]; });
    };
    mB.addEventListener('click',()=>set('monthly'));
    yB.addEventListener('click',()=>set('yearly'));
    set('yearly');
  }

  renderVals(){
    return {
      btnMonthly:(el)=>{this.btnMonthly=el;},
      btnYearly:(el)=>{this.btnYearly=el;},
      saveTag:(el)=>{this.saveTag=el;}
    };
  }
}
</script>
