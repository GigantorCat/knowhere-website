class Component extends DCLogic {
  componentDidMount(){
    const root=document.querySelector('.kw-exp'); if(!root) return;
    this.root=root;
    this.wireDemo(root);
    this.sizeWidget(root);
    const boot=()=>{
      if(!window.KnowherePage||!window.KnowhereParticleBanner){ return setTimeout(boot,50); }
      window.KnowherePage.injectLogo(root);
      this._stopBanner=window.KnowhereParticleBanner(root,'Experience it','modes');
    };
    boot();
  }
  componentWillUnmount(){ if(this._stopBanner) this._stopBanner(); if(this._widgetIv) clearInterval(this._widgetIv); if(this._widgetFit) window.removeEventListener('resize',this._widgetFit); if('speechSynthesis' in window) speechSynthesis.cancel(); }

  // Grow the widget iframe to its content's true height so nothing scrolls inside it.
  sizeWidget(root){
    const f=root.querySelector('.widget-panel iframe'); if(!f) return;
    const fit=()=>{
      try{
        const d=f.contentDocument; if(!d||!d.body) return;
        const prev=d.body.style.minHeight;
        d.body.style.minHeight='0px';               // release the 100vh floor so body reports natural height
        const h=Math.max(d.body.scrollHeight, d.documentElement.scrollHeight);
        d.body.style.minHeight=prev||'';
        if(h>120){ f.style.minHeight=h+'px'; f.style.height=h+'px'; }
      }catch(e){}
    };
    this._widgetFit=fit;
    f.addEventListener('load',()=>{ fit(); setTimeout(fit,300); setTimeout(fit,1200); });
    let n=0; this._widgetIv=setInterval(()=>{ fit(); if(++n>24) clearInterval(this._widgetIv); },500);
    window.addEventListener('resize',fit);
  }

  wireDemo(root){
    let ennea="7", neuro="none";
    const ENNEA={
      "7":{name:"Type 7 — The Enthusiastic Generalist",accent:"#7BEA5A",hook:"Plot twist: gravity isn't pulling you down. The floor is pushing you up.",angle:"This one idea connects falling apples, black holes, GPS satellites, and why time literally runs slower at sea level. <strong>Same demo, four rabbit holes</strong> — trace whichever thread looks shiniest.",nudge:"Poke the demo. Crank it to extremes and see what breaks. Curiosity first, formalism after — that's your fastest route to actually owning this."},
      "3":{name:"Type 3 — The Ambitious Achiever",accent:"#EAB35A",hook:"Einstein rewrote Newton. Examiners love asking why.",angle:"Gravity-as-geometry is the concept that separates a solid mark from a <strong>top-band answer</strong>. Master the reframe — mass curves spacetime, objects follow the curve — and Unit 3's hardest marks are on the table.",nudge:"Efficient route: 4 minutes with the demo, then explain the curvature out loud in under 60 seconds. If you can't, you've found exactly what to drill. Measurable. Done."},
      "5":{name:"Type 5 — The Analytical Investigator",accent:"#5AD9EA",hook:"Newton's \u201cforce\u201d was a placeholder. Here's what's actually happening.",angle:"Mass curves spacetime; objects follow <strong>geodesics</strong> — straight paths through curved geometry. Nothing pulls. The rabbit hole runs deep: from orbital mechanics to the clock corrections GPS satellites make every day.",nudge:"Before you touch the demo, predict the curvature change. Then test. The gap between your model and the demo's behaviour is where the real understanding lives."}
    };
    const NEURO={
      none:{label:"",fmt:"standard"},
      adhd:{label:" + ADHD layer",fmt:"adhd — short, instant feedback, no timer",brain:"Your brain runs on <strong>interest-based attention</strong>, not effort-based. Novelty and motion light it up — which is exactly why this widget works when a textbook page doesn't. The boring middle of a topic is genuinely harder for you than for most people, so we don't do boring middles.",nudge:"<strong>10-minute sprint:</strong> drag the demo, say the idea out loud once, done. Short blocks, real breaks. If you zone out, the app hands you back your last thread — no guilt lap required."},
      asd:{label:" + ASD layer",fmt:"asd — explicit criteria, zero ambiguity",brain:"Your brain is built for <strong>pattern recognition and systematic rules</strong>. Gravity-as-geometry is rule-based with clear right answers — natural territory for you. Ambiguity is the friction point, so every criterion here is stated explicitly. No guessing what a \u201cgood answer\u201d means.",nudge:"<strong>Rules first, then application:</strong> the full principle is stated before you touch the demo. The marking criteria are shown up front, and the format won't change on you mid-task."},
      dys:{label:" + Dyslexia layer",fmt:"dyslexia — minimal text, audio on tap",brain:"Your brain does strong <strong>verbal and visual reasoning</strong> — dense text is the tax, not the thinking. So text stays short, the visuals carry the meaning, and audio is always one tap away.",nudge:"<strong>Audio-first:</strong> listen to the explanation, then explain it back out loud. Diagrams over written notes. Your understanding was never the problem — the format was."}
    };
    const QUIZ={
      none:{criteria:null,q:"According to general relativity, why does a satellite stay in orbit around Earth?",dysMode:false,opts:[{k:"A",t:"Earth exerts an attractive force that pulls it in a circle",ok:false},{k:"B",t:"It follows a straight path through spacetime that Earth's mass has curved",ok:true},{k:"C",t:"Its engines constantly correct its course",ok:false},{k:"D",t:"Magnetic attraction between the satellite and Earth's core",ok:false}],good:"Correct — the satellite travels a geodesic: a straight line through curved spacetime. Nothing is pulling it.",bad:"Not quite. Think about what the widget shows: the mass curves the grid, and the orbit follows the curve.",hint:"Hint: in Einstein's picture, no force is involved at all. What shape is the satellite's path through curved spacetime?"},
      adhd:{criteria:null,q:"Why does a satellite orbit Earth?",dysMode:false,opts:[{k:"A",t:"Earth pulls it with a force",ok:false},{k:"B",t:"Straight line through curved spacetime",ok:true},{k:"C",t:"Engines keep turning it",ok:false}],good:"YES. Straight line, curved space. That's the whole trick — you've got it. \uD83C\uDF89",bad:"Close — but no pulling involved. Look at the grid in the widget. What's the path following?",hint:"Quick hint: forget forces. The mass bends the grid; the satellite just goes straight — through bent space."},
      asd:{criteria:"<b>Marking criterion:</b> the correct answer must describe motion along a geodesic — a straight path through spacetime curved by mass. Any answer describing a pulling force is incorrect under the general relativity model. There are no trick options.",q:"In the general relativity model, which statement correctly describes why a satellite remains in orbit around Earth?",dysMode:false,opts:[{k:"A",t:"Earth exerts an attractive force on the satellite at a distance (Newtonian model)",ok:false},{k:"B",t:"The satellite follows a geodesic: a straight path through spacetime that Earth's mass has curved",ok:true},{k:"C",t:"The satellite's engines continuously adjust its trajectory",ok:false},{k:"D",t:"Magnetic attraction acts between the satellite and Earth's core",ok:false}],good:"Correct. B satisfies the criterion exactly: geodesic motion through curved spacetime, no force. A describes the Newtonian model, which this question explicitly excludes.",bad:"Incorrect against the stated criterion. Re-read it: the answer must describe a geodesic through curved spacetime, not a force.",hint:"Apply the criterion directly: which option contains \u201cstraight path through curved spacetime\u201d and no force language?"},
      dys:{criteria:null,q:"A satellite orbits Earth because…",dysMode:true,opts:[{k:"\uD83E\uDDF2",t:"Magnets pull it",ok:false},{k:"\u27B0",t:"It goes straight — through curved space",ok:true},{k:"\uD83D\uDE80",t:"Engines steer it",ok:false}],good:"Yes! Space is curved. The satellite just goes straight. \uD83C\uDF89",bad:"Not this one. Tap \uD83D\uDD0A and listen again — then look at the curved grid.",hint:"Say it out loud: \u201cmass bends space — things follow the bend.\u201d Now pick the one that matches."}
    };

    const $=id=>root.querySelector('#'+id);
    const framing=$('framing'), quizPanel=$('quizPanel');
    let answered=false;

    const renderFraming=(instant)=>{
      const E=ENNEA[ennea], N=NEURO[neuro];
      const swap=()=>{
        $('hook').textContent=E.hook;
        $('angle').innerHTML=E.angle;
        $('nudge').innerHTML=(neuro!=="none")?N.nudge:E.nudge;
        $('nudgeChip').classList.toggle('hidden',neuro==="none");
        $('brainBlock').classList.toggle('hidden',neuro==="none");
        if(neuro!=="none") $('brainText').innerHTML=N.brain;
        $('typeName').textContent=E.name;
        $('neuroName').innerHTML=neuro==="none"?"":' <span class="nb">'+N.label+'</span>';
        root.style.setProperty('--accent',E.accent);
        framing.classList.remove('swapping');
      };
      if(instant){ swap(); return; }
      framing.classList.add('swapping'); setTimeout(swap,220);
    };

    const renderQuiz=(instant)=>{
      const Q=QUIZ[neuro];
      const swap=()=>{
        answered=false;
        $('quizFmt').textContent='format: '+NEURO[neuro].fmt;
        $('criteria').classList.toggle('hidden',!Q.criteria);
        if(Q.criteria) $('criteria').innerHTML=Q.criteria;
        const qt=$('qText'); qt.textContent=Q.q; qt.classList.toggle('dys',Q.dysMode);
        $('readBtn').classList.toggle('hidden',!Q.dysMode||!('speechSynthesis' in window));
        const fb=$('feedback'); fb.textContent=''; fb.className='feedback';
        const box=$('options'); box.innerHTML='';
        Q.opts.forEach(o=>{
          const b=document.createElement('button');
          b.className='opt'+(Q.dysMode?' dys':'');
          b.innerHTML='<span class="key">'+o.k+'</span><span>'+o.t+'</span>';
          b.addEventListener('click',()=>{
            if(answered) return; answered=true;
            b.classList.add(o.ok?'correct':'wrong');
            if(!o.ok){ box.querySelectorAll('.opt').forEach((el,i)=>{ if(Q.opts[i].ok) el.classList.add('correct'); }); }
            fb.textContent=o.ok?Q.good:Q.bad;
            fb.className='feedback '+(o.ok?'good':'bad');
          });
          box.appendChild(b);
        });
        quizPanel.classList.remove('swapping');
      };
      if(instant){ swap(); return; }
      quizPanel.classList.add('swapping'); setTimeout(swap,220);
    };

    $('unstuckBtn').addEventListener('click',()=>{ const fb=$('feedback'); fb.textContent=QUIZ[neuro].hint; fb.className='feedback'; });
    $('resetBtn').addEventListener('click',()=>renderQuiz(true));
    $('readBtn').addEventListener('click',()=>{
      if(!('speechSynthesis' in window)) return;
      speechSynthesis.cancel();
      const Q=QUIZ[neuro];
      const text=Q.q+'. '+Q.opts.map(o=>o.t).join('. Or. ');
      speechSynthesis.speak(new SpeechSynthesisUtterance(text));
    });

    const DESC="This widget shows a two dimensional grid representing spacetime. A large mass sits in the centre, warping the grid downward like a weight on a stretched sheet. A smaller object moves in a straight line — but because the grid itself is curved, its path bends into an orbit. Drag the mass to change its size, and watch how the curvature, and the orbit, respond. The takeaway: gravity is not a pulling force. It is the shape of space itself.";
    const listenBtn=$('listenBtn');
    listenBtn.addEventListener('click',function(){
      if(!('speechSynthesis' in window)) return;
      if(speechSynthesis.speaking){ speechSynthesis.cancel(); this.classList.remove('speaking'); return; }
      const u=new SpeechSynthesisUtterance(DESC);
      u.onend=()=>this.classList.remove('speaking');
      this.classList.add('speaking');
      speechSynthesis.speak(u);
    });

    root.querySelectorAll('[data-ennea]').forEach(btn=>{
      btn.addEventListener('click',()=>{
        ennea=btn.dataset.ennea;
        root.querySelectorAll('[data-ennea]').forEach(b=>b.classList.toggle('active',b===btn));
        renderFraming();
      });
    });
    root.querySelectorAll('[data-neuro]').forEach(btn=>{
      btn.addEventListener('click',()=>{
        neuro=btn.dataset.neuro;
        root.querySelectorAll('[data-neuro]').forEach(b=>b.classList.toggle('active',b===btn));
        renderFraming(); renderQuiz();
      });
    });

    renderFraming(true);
    renderQuiz(true);
  }
}
</script>

