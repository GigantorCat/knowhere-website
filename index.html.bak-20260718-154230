    let idx=0, frac=0;
    for(let i=0;i<S.length;i++){
      const top=S[i].offsetTop, next=S[i+1]?S[i+1].offsetTop:top+S[i].offsetHeight;
      if(mid>=top&&mid<next){ idx=i; frac=(mid-top)/(next-top); break; }
      if(mid>=next&&i===S.length-1){ idx=i; frac=1; }
    }
    return {idx,frac};
  }

  frame(now){
    const cv=this.stageRef; if(!cv) return;
    const vw=window.innerWidth, vh=window.innerHeight;
    if(cv._w!==vw||cv._h!==vh){ cv._w=vw; cv._h=vh; cv.width=Math.round(vw*this.dpr); cv.height=Math.round(vh*this.dpr); }
    const ctx=cv.getContext('2d');
    ctx.setTransform(this.dpr,0,0,this.dpr,0,0);
    ctx.clearRect(0,0,vw,vh);
    const t=(now-this.t0)/1000;
    const {idx,frac}=this.scrollState();
    const last=this.targets.length-1;
    let mRaw=Math.max(0,(frac-0.55)/0.45);
    let A=this.targets[Math.min(idx,last)];
    let B=this.targets[Math.min(idx+1,last)];
    let accA=this.shapeAcc[Math.min(idx,last)], accB=this.shapeAcc[Math.min(idx+1,last)];
    let rotW=this.rotFlags[Math.min(idx,last)]*(1-mRaw)+this.rotFlags[Math.min(idx+1,last)]*mRaw;
    let pulseW=0; // brain pathway pulsing weight
    let offOverride=null;
    if(idx===9){
      // sub-timeline: fingerprint → styles → brain → modes → banner halo
      const T=this.sub6T, L=this.sub6.length-1; let j=0;
      for(let k=T.length-1;k>=0;k--){ if(frac>=T[k]){ j=k; break; } }
      if(j<L){
        A=this.sub6[j]; B=this.sub6[j+1];
        mRaw=Math.max(0,Math.min(1,(frac-(T[j+1]-0.14))/0.14));
        accA=this.sub6Acc[j]; accB=this.sub6Acc[j+1];
        rotW=this.sub6Rot[j]*(1-mRaw)+this.sub6Rot[j+1]*mRaw;
        offOverride=[this.sub6Off[j],this.sub6Off[j+1]];
      } else {
        A=this.sub6[L]; B=this.targets[10];
        mRaw=Math.max(0,Math.min(1,(frac-0.90)/0.10));
        accA=this.sub6Acc[L]; accB=this.shapeAcc[10];
        rotW=this.sub6Rot[L]*(1-mRaw)+this.rotFlags[10]*mRaw;
        offOverride=[this.sub6Off[L],0];
      }
      pulseW=(j===2?1-mRaw:(j===1?mRaw:0));
    }
    this._greenAll=0;
    if(idx===12){
      // outro sub-timeline: "nowhere" settles → greens sweep in from stage left
      // to build the "k" → the whole word turns brat green
      A=this.outNowhere; B=this.outFull;
      mRaw=Math.max(0,Math.min(1,(frac-0.12)/0.16));
      rotW=0; offOverride=[0,0];
      this._greenAll=Math.max(0,Math.min(1,(frac-0.32)/0.16));
    }
    // problem section: the brain starts firing here, ramping in as it arrives
    if(idx===2){ pulseW=Math.max(pulseW,0.9); }
    else if(idx===1){ pulseW=Math.max(pulseW,mRaw*0.9); }
    // ── banner VFX: IYKYK glyphs disintegrate into the brain on scroll ──
    let gAl=1;
    const bn=this.sections[0], bh=bn?bn.offsetHeight:0;
    if(bh&&window.scrollY<bh&&this.bannerShape){
      const bp=Math.max(0,Math.min(1,window.scrollY/(bh*0.8)));
      A=this.bannerShape; B=this.targets[1];
      mRaw=bp; rotW=0;
      offOverride=[0,0]; pulseW=0;
      gAl=Math.min(1,0.12+window.scrollY/(bh*0.3));
      // the IYKYK video text mask disintegrates into speckles as you scroll
      if(this.erodeMask) this.erodeMask(Math.max(0,Math.min(1,window.scrollY/(bh*0.5))));
      // banner DOM content dissolves as the particles take over
      const fadeP=Math.max(0,Math.min(1,window.scrollY/(bh*0.42)));
      for(const ch of bn.querySelectorAll('[data-bn-fade]')){
        ch.style.opacity=(1-fadeP).toFixed(3);
        ch.style.transform='translateY('+(-fadeP*46).toFixed(1)+'px)';
      }
      this._bnFaded=true;
    } else if(this._bnFaded&&bn){
      for(const ch of bn.querySelectorAll('[data-bn-fade]')){ ch.style.opacity='0'; }
    }
    // rotation weight blends smoothly between sections; planar sub-shapes get a
    // gentle face-on sway instead of a full rotation
    const rot=Math.sin(t*0.38)*0.3*rotW;
    const cosR=Math.cos(rot), sinR=Math.sin(rot);
    const cx=vw/2, cy=vh/2, fov=900;
    ctx.globalCompositeOperation='lighter';
    const warm={r:237,g:236,b:230};
    const offA=offOverride?offOverride[0]:this.shapeOffX[Math.min(idx,last)], offB=offOverride?offOverride[1]:this.shapeOffX[Math.min(idx+1,last)];
    for(let i=0;i<this.N;i++){
      const d=this.seedOrder[i]*0.35;
      const f=Math.min(1,Math.max(0,(mRaw-d)/(1-0.35)));
      const e=f*f*(3-2*f);
      const i3=i*3;
      let tx=A[i3]+(B[i3]-A[i3])*e, ty=A[i3+1]+(B[i3+1]-A[i3+1])*e, tz=A[i3+2]+(B[i3+2]-A[i3+2])*e;
      tx+=Math.sin(t*0.7+i*1.3)*2.2; ty+=Math.cos(t*0.6+i*0.7)*2.2;
      this.px[i3]+=(tx-this.px[i3])*0.075;
      this.px[i3+1]+=(ty-this.px[i3+1])*0.075;
      this.px[i3+2]+=(tz-this.px[i3+2])*0.075;
      const x=this.px[i3], y=this.px[i3+1], z=this.px[i3+2];
      const rx=x*cosR+z*sinR, rz=-x*sinR+z*cosR;
      const sc=fov/(fov+rz);
      const sx=cx+rx*sc+(offA+(offB-offA)*e), sy=cy+y*sc;
      if(sx<-10||sx>vw+10||sy<-10||sy>vh+10) continue;
      const depth=Math.max(0,Math.min(1,(sc-0.8)*2.4));
      const g=this.greens[i];
      let col=warm;
      if(!g&&this._greenAll>0){
        const wG=this._greenAll;
        col={r:(237+(123-237)*wG)|0, g:(236+(234-236)*wG)|0, b:(230+(90-230)*wG)|0};
      }
      if(g){
        if(!this.SPEC) this.SPEC=[{r:241,g:85,b:36},{r:252,g:184,b:21},{r:123,g:234,b:90},{r:35,g:164,b:221},{r:133,g:72,b:150},{r:236,g:21,b:89}];
        const sA=Math.min(idx,last), sB=Math.min(idx+1,last);
        let cA=accA, cB=accB;
        if(sA<=1) cA=warm;                                                     // hero: not coloured yet
        else if(sA===2) cA=this.SPEC[(((this.seedOrder[i]*6+frac*10)|0)%6+6)%6];
        else if(sA===8) cA=this.SPEC[((this.seedOrder[i]*6)|0)%6];
        if(sB<=1) cB=warm;
        else if(sB===2) cB=this.SPEC[(((this.seedOrder[i]*6+frac*10)|0)%6+6)%6];
        else if(sB===8) cB=this.SPEC[((this.seedOrder[i]*6)|0)%6];
        col={r:cA.r+(cB.r-cA.r)*e, g:cA.g+(cB.g-cA.g)*e, b:cA.b+(cB.b-cA.b)*e};
        col={r:col.r|0, g:col.g|0, b:col.b|0};
      }
      let al=(g?0.5:0.28)+depth*(g?0.5:0.5);
      if(!g&&this._greenAll>0) al=Math.min(1,al*(1+this._greenAll*0.6));
      if(g&&pulseW>0){
        // travelling firing pulse: a bright wavefront sweeps along each pathway
        const ph=this.seedOrder[i]*6.283;
        const wave=0.5+0.5*Math.sin(t*3.2+ph);
        const spike=Math.pow(0.5+0.5*Math.sin(t*5.1-ph*2.0),6); // sharp travelling spark
        al*=(1-pulseW)+pulseW*(0.2+0.6*wave+1.4*spike);
        if(al>1) al=1;
      }
      if(gAl<1) al*=gAl;
      ctx.fillStyle='rgba('+col.r+','+col.g+','+col.b+','+al.toFixed(3)+')';
      let r=(g?1.3:0.9)+depth*1.3;
      if(g&&pulseW>0&&al>0.75){ r+=1.1; } // firing neurons swell
      ctx.fillRect(sx-r/2,sy-r/2,r,r);
    }
    // network lines (section 11)
    const netVis=(idx===11?1-mRaw:(idx===10?mRaw:0));
    if(netVis>0.05&&this.netNodes){
      const S=this.R*1.35, nn=this.netNodes;
      ctx.lineWidth=0.7;
      for(let i=0;i<nn.length;i++)for(let j=i+1;j<nn.length;j++){
        const A2=nn[i],B2=nn[j];
        const dx=(A2.x-B2.x)*S*0.7, dy=(A2.y-B2.y)*S*0.5, dz=(A2.z-B2.z)*S*0.4;
        if(dx*dx+dy*dy+dz*dz>S*S*0.22) continue;
        const p1=this.proj(A2.x*S*0.7-vw*0.08,A2.y*S*0.5,A2.z*S*0.4,cosR,sinR,cx,cy,fov);
        const p2=this.proj(B2.x*S*0.7-vw*0.08,B2.y*S*0.5,B2.z*S*0.4,cosR,sinR,cx,cy,fov);
        ctx.strokeStyle='rgba(180,190,200,'+(0.16*netVis)+')';
        ctx.beginPath(); ctx.moveTo(p1[0],p1[1]); ctx.lineTo(p2[0],p2[1]); ctx.stroke();
      }
    }
    ctx.globalCompositeOperation='source-over';
    // bokeh
    if(!this._bok){ this._bok=Array.from({length:6},(_,k)=>({x:Math.random(),y:Math.random(),r:30+Math.random()*40,ph:k*1.7})); }
    ctx.globalCompositeOperation='lighter';
    for(const b of this._bok){
      const bx=b.x*vw+Math.sin(t*0.2+b.ph)*30, by=b.y*vh+Math.cos(t*0.16+b.ph)*24;
      const gd=ctx.createRadialGradient(bx,by,0,bx,by,b.r);
      const pulse=0.05+0.04*Math.sin(t*0.8+b.ph);
      gd.addColorStop(0,'rgba(237,236,225,'+pulse+')'); gd.addColorStop(1,'rgba(237,236,225,0)');
      ctx.fillStyle=gd; ctx.beginPath(); ctx.arc(bx,by,b.r,0,7); ctx.fill();
    }
    ctx.globalCompositeOperation='source-over';
    // hero fades in behind the exiting banner, eased both ways
    const hero=this._hero||(this._hero=document.querySelector('[data-hero-fade]'));
    if(hero){
      const p=Math.max(0,Math.min(1,(window.scrollY/vh-0.25)/0.6));
      const eh=p*p*(3-2*p);
      hero.style.opacity=eh.toFixed(3);
      hero.style.transform='translateY('+((1-eh)*26).toFixed(1)+'px)';
    }
    // text fade per section; subject cards use a tighter window so the card
    // arrives in sync with its particle formation
    if(!this._syncSet){ this._syncSet=new Set(this.fades.filter(el=>{ const s=el.closest('[data-screen-label]'); return s&&/^Subject/.test(s.getAttribute('data-screen-label')); })); }
    for(let i=0;i<this.fades.length;i++){
      const el=this.fades[i], r=el.getBoundingClientRect();
      const center=r.top+r.height/2, dist=Math.abs(center-vh/2);
      const tight=this._syncSet.has(el);
      const op=Math.max(0,Math.min(1,(tight?1.12:1.25)-dist/(vh*(tight?0.30:0.42))));
      el.style.opacity=op.toFixed(3);
      el.style.transform='translateY('+((1-op)*(tight?34:18)).toFixed(1)+'px)';
    }
    // staged steps inside the fingerprint section (idx 9)
    const fp=this.sections[9];
    if(fp&&this.steps.length){
      const top=fp.offsetTop, hgt=fp.offsetHeight;
      const fFrac=(window.scrollY+vh/2-top)/hgt;
      // cards column recedes as the banner finale takes the stage
      const col=this._fpCol||(this._fpCol=document.querySelector('[data-fp-col]'));
      if(col){ const ho=1-Math.max(0,Math.min(1,(fFrac-0.74)/0.06));
        col.style.opacity=ho.toFixed(3);
        col.style.transform='translateY('+((1-ho)*-30).toFixed(1)+'px)'; }
      // title lockup: visible with the fingerprint, fades out as the first card floats in
      const ttl=this._fpTitle||(this._fpTitle=fp.querySelector('[data-fp-title]'));
      if(ttl){
        let ti=Math.max(0,Math.min(1,(fFrac-0.02)/0.10));
        let to=Math.max(0,Math.min(1,(fFrac-0.24)/0.10));
        ti=ti*ti*(3-2*ti); to=to*to*(3-2*to);
        ttl.style.opacity=(ti*(1-to)).toFixed(3);
        ttl.style.transform='translateY('+((1-ti)*24-to*30).toFixed(1)+'px)';
      }
      for(const el of this.steps){
        const thr=parseFloat(el.dataset.step);
        const op=Math.max(0,Math.min(1,(fFrac-(thr-0.08))/0.08));
        const ee=op*op*(3-2*op);
        el.style.opacity=ee.toFixed(3);
        el.style.transform='translateY('+((1-ee)*64).toFixed(1)+'px)';
      }
      // one-at-a-time cards: float in from below as their formation assembles,
      // float out upward as the particles dissipate into the next one
      const cards=this._fpCards||(this._fpCards=[...fp.querySelectorAll('[data-cin]')]);
      for(const el of cards){
        const cin=parseFloat(el.dataset.cin), cout=parseFloat(el.dataset.cout);
        let ip=Math.max(0,Math.min(1,(fFrac-(cin-0.14))/0.14));
        let op2=Math.max(0,Math.min(1,(fFrac-(cout-0.14))/0.14));
        ip=ip*ip*ip*(ip*(ip*6-15)+10); op2=op2*op2*op2*(op2*(op2*6-15)+10);
        el.style.opacity=(ip*(1-op2)).toFixed(3);
        el.style.transform='translateY('+((1-ip)*56-op2*46).toFixed(1)+'px)';
      }
    }
  }
  proj(x,y,z,cosR,sinR,cx,cy,fov){
    const rx=x*cosR+z*sinR, rz=-x*sinR+z*cosR, sc=fov/(fov+rz);
    return [cx+rx*sc, cy+y*sc];
  }

  renderVals(){
    return {
      stageRef:(el)=>{this.stageRef=el;},
      logoNavRef:(el)=>{this.logoNavRef=el;},
      logoFootRef:(el)=>{this.logoFootRef=el;},
      maskRef:(el)=>{this.maskRef=el;},
      vidRef:(el)=>{this.vidRef=el;},
      greenRef:(el)=>{this.greenRef=el;},
    };
  }
}
</script>
</body>
